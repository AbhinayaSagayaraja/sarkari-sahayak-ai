# Copy to .env and add your key from https://dashboard.sarvam.ai
# Without a key the app runs in offline mode (rule-based extraction, browser voice).
SARVAM_API_KEY=your_key_here

# Optional overrides (defaults shown)
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya
# PORT=8000
